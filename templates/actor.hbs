<section class="wbc-body">
<header class="identity"><img src="{{actor.img}}" alt="Actor portrait"><div><small>WHITE BOX CYCLOPEDIA</small><input class="name" name="name" value="{{actor.name}}" aria-label="Name"><input name="system.alignment" value="{{system.alignment}}" placeholder="Alignment" aria-label="Alignment"></div></header>
<div class="abilities">{{#each abilities}}<label>{{label}}<input type="number" min="3" max="18" name="system.abilities.{{key}}" value="{{value}}"><small>Modifier {{modifier}}</small></label>{{/each}}</div>
<h2>Adventurer</h2><div class="grid"><label>Level<input type="number" name="system.level" value="{{system.level}}"></label><label>XP<input type="number" name="system.xp" value="{{system.xp}}"></label><label>Next level XP<input type="number" name="system.nextLevelXP" value="{{system.nextLevelXP}}"></label><label>HP<input type="number" name="system.hp.value" value="{{system.hp.value}}"></label><label>Maximum HP<input type="number" name="system.hp.max" value="{{system.hp.max}}"></label><label>Descending AC<input type="number" name="system.ac" value="{{system.ac}}"></label><label>Attack bonus<input type="number" name="system.attackBonus" value="{{system.attackBonus}}"></label><label>Save target<input type="number" name="system.save" value="{{system.save}}"></label><label>Movement<input type="number" name="system.movement" value="{{system.movement}}"></label></div><p>Ascending AC: <strong>{{aac}}</strong> · Carried equipment weight: {{weight}} lb.</p><button type="button" data-action="save">Roll saving throw</button>
{{#if isNPC}}<h2>Monster</h2><div class="grid"><label>Hit dice<input type="text" name="system.hitDice" value="{{system.hitDice}}"></label><label>Morale<input type="number" name="system.morale" value="{{system.morale}}"></label><label>Treasure<input type="text" name="system.treasure" value="{{system.treasure}}"></label><label>Special<input type="text" name="system.special" value="{{system.special}}"></label></div>{{/if}}<h2>Coins and languages</h2><div class="grid"><label>Copper<input type="number" name="system.coins.cp" value="{{system.coins.cp}}"></label><label>Silver<input type="number" name="system.coins.sp" value="{{system.coins.sp}}"></label><label>Gold<input type="number" name="system.coins.gp" value="{{system.coins.gp}}"></label><label>Languages<input type="text" name="system.languages" value="{{system.languages}}"></label></div><h2>Daily spell slots</h2><p>Remaining / maximum; track separately from prepared copies.</p><div class="grid">{{#each system.spellSlots}}<label>Level {{@key}}<span class="pair"><input aria-label="Remaining slots" type="number" min="0" name="system.spellSlots.{{@key}}.value" value="{{value}}"><input aria-label="Maximum slots" type="number" min="0" name="system.spellSlots.{{@key}}.max" value="{{max}}"></span></label>{{/each}}</div>{{#each groups}}<section class="item-group"><h2>{{label}} {{#if ../editable}}<button type="button" data-action="createItem" data-type="{{type}}">+ Add</button>{{/if}}</h2>
{{#each items}}<div class="item-row" data-item-id="{{id}}"><button type="button" data-action="editItem">{{name}}</button><span>{{#if system.quantity}}× {{system.quantity}}{{/if}}{{#if system.damage}}{{system.damage}}{{/if}}{{#if system.tradition}} {{system.tradition}} · Level {{system.level}} · Prepared {{system.prepared}}, expended {{system.expended}}{{/if}}</span>{{#if ../../editable}}<button type="button" data-action="useItem">Use / Roll</button><button type="button" data-action="damage">Damage</button><button type="button" data-action="deleteItem" aria-label="Delete {{name}}">×</button>{{/if}}</div>{{else}}<p class="empty">No items yet. Add an item or drag one from the Items directory.</p>{{/each}}</section>{{/each}}
<h2>Notes</h2><textarea name="system.biography" rows="6">{{system.biography}}</textarea></section>