<section class="wbc-body"><header class="identity"><img src="{{item.img}}" alt="Item artwork"><input class="name" name="name" value="{{item.name}}" aria-label="Item name"></header><div class="grid">{{#each fields}}<label>{{label}}{{#if isBoolean}}<input type="checkbox" name="system.{{key}}" {{checked value}}>{{else}}<input type="{{#if isNumber}}number{{else}}text{{/if}}" name="system.{{key}}" value="{{value}}">{{/if}}</label>{{/each}}</div>{{#if hasUses}}<div class="grid"><label>Uses remaining<input type="number" name="system.uses.value" value="{{system.uses.value}}"></label><label>Maximum uses<input type="number" name="system.uses.max" value="{{system.uses.max}}"></label></div>{{/if}}<h2>Description</h2><textarea name="system.description" rows="12">{{system.description}}</textarea><p>Spell preparation and expenditure are per item. Armor AC and progression are entered on the actor manually.</p></section>